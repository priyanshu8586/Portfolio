# Copy to .env and replace the placeholders. Never commit the real .env.

NODE_ENV=development
PORT=3000

# Public URL of the site (used for the Origin check on form posts and cookie behaviour)
APP_BASE_URL=http://localhost:3000

# PostgreSQL connection string, e.g. postgresql://user:password@localhost:5432/portfolio
DATABASE_URL=replace_with_your_postgres_connection_string

# Set to true for managed databases that require TLS (Neon, Supabase, Render, Railway...)
DATABASE_SSL=false

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret

# Set to 1 when running behind a reverse proxy / PaaS (Render, Railway, Fly, Heroku...)
TRUST_PROXY=0
